# Public browser-safe Supabase values. Never put a service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Supabase secret key (preferred). Keep private; never commit or expose it to the browser.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Optional legacy fallback; Supabase is moving from service_role to secret keys.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# App URL used for auth callbacks and public intake links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (Gmail send + Calendar event creation).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
INTAKE_RATE_LIMIT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: notifications to a business owner when a public form is submitted.
# The sender must be verified with your email provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LeadFlow <notifications@your-verified-domain.com>

# Optional production anti-bot layer. Recommended before enabling a public intake form.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
